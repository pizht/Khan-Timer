{
  "name": "khan-academy-timer",
  "version": "0.1.6",
  "private": true,
  "description": "Question timer overlay for Khan Academy exercises and quizzes. Microsoft Edge (Chromium), Manifest V3.",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build && node scripts/verify-dist.mjs",
    "verify:edge": "npm run build && node scripts/verify-extension.mjs",
    "verify:startcard": "npm run build && node scripts/verify-startcard-flash.mjs",
    "verify:all": "npm run verify && npm run verify:edge",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@rollup/wasm-node": "4.64.2",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
